# Kopiraj u .env i popuni pravim vrednostima.
# .env je u .gitignore — NIKAD ga ne commit-uj.

# ---------------------------------------------------------------
# Baza podataka (PostgreSQL)
# ---------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/narodnanosnja_db?schema=public"

# ---------------------------------------------------------------
# Autentifikacija (NextAuth)
# Tajne napravi zasebno sa: openssl rand -base64 32
# ---------------------------------------------------------------
NEXTAUTH_SECRET="promeni-me-na-nasumican-niz"
ORDER_ACCESS_SECRET="drugi-nasumican-niz-za-linkove-porudzbina"
NEXTAUTH_URL="https://narodnanosnja.rs"

# ---------------------------------------------------------------
# Identitet prodavnice — početne/fallback vrednosti. Posle prvog
# pokretanja ADMIN ih menja u Podešavanja bez izmene .env fajla.
# ---------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Народна ношња"
NEXT_PUBLIC_STORE_TAGLINE="ručno tkano"
NEXT_PUBLIC_STORE_DESCRIPTION="Ručno tkani proizvodi, nastali od prirodnih materijala."
NEXT_PUBLIC_STORE_EMAIL="info@narodnanosnja.rs"
NEXT_PUBLIC_SITE_URL="https://narodnanosnja.rs"
NEXT_PUBLIC_STORE_PHONE="+381 60 000 0000"
NEXT_PUBLIC_STORE_ADDRESS="Adresa radionice"
NEXT_PUBLIC_STORE_CITY="Beograd"
NEXT_PUBLIC_BUSINESS_HOURS="Pon - Pet: 09:00 - 17:00"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_MAPS_EMBED_URL=""
NEXT_PUBLIC_LOCALE="sr"

# Dostava — početne vrednosti, zatim se uređuju kroz ADMIN podešavanja
SHIPPING_COST="450"
FREE_SHIPPING_THRESHOLD="10000"
MINIMUM_ORDER_SUBTOTAL="0"
NEXT_PUBLIC_DEFAULT_COUNTRY="Srbija"

# Moduli prodavnice. Kartice uključiti tek po uspešnoj NestPay sertifikaciji.
NEXT_PUBLIC_CASH_ON_DELIVERY_ENABLED="true"
NEXT_PUBLIC_CARD_PAYMENTS_ENABLED="false"
NEXT_PUBLIC_WISHLIST_ENABLED="true"
NEXT_PUBLIC_REVIEWS_ENABLED="true"
NEXT_PUBLIC_NEWSLETTER_ENABLED="true"
NEXT_PUBLIC_CHAT_ENABLED="true"
NEXT_PUBLIC_STORE_LOCATIONS_ENABLED="false"
NEXT_PUBLIC_CAREERS_ENABLED="false"
NEXT_PUBLIC_ENGLISH_LOCALE_ENABLED="false"
# NEXT_PUBLIC_COMPLAINT_FORM_URL="/dokumenti/obrazac-reklamacije.pdf"

# ---------------------------------------------------------------
# Prvi administrator (koristi scripts/create-admin.ts)
# ---------------------------------------------------------------
ADMIN_EMAIL="admin@narodnanosnja.rs"
ADMIN_PASSWORD="promeni-me"

# ---------------------------------------------------------------
# Slanje pošte — potvrde porudžbina, resetovanje lozinke
# ---------------------------------------------------------------
SMTP_SERVER_HOST=""
SMTP_SERVER_PORT="587"
SMTP_SERVER_USERNAME=""
SMTP_SERVER_PASSWORD=""
EMAIL_FROM="Narodna nošnja <porudzbine@narodnanosnja.rs>"
# Ostaviti true u produkciji; false je samo za lokalni self-signed SMTP.
SMTP_TLS_REJECT_UNAUTHORIZED="true"

# ---------------------------------------------------------------
# Analitika (opciono)
# ---------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---------------------------------------------------------------
# reCAPTCHA v3 — OBAVEZNO u produkciji kada je checkout dostupan.
# Bez oba ključa order API namerno odbija porudžbine (fail-closed).
# ---------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# RECAPTCHA_MIN_SCORE="0.5"
# RECAPTCHA_ALLOWED_HOSTNAMES="example.com,www.example.com"

# ---------------------------------------------------------------
# Kartično plaćanje (NestPay) — uvodi se tek kad postoji ugovor
# sa bankom i sertifikovan callback tok. Svi URL-ovi moraju biti HTTPS;
# OK/FAIL URL mora koristiti isti origin kao NEXT_PUBLIC_SITE_URL i tačnu
# putanju ispod. Do tada radi samo plaćanje pouzećem.
# ---------------------------------------------------------------
# NESTPAY_CLIENT_ID=""
# NESTPAY_STORE_KEY=""
# NESTPAY_HPP_URL_TEST="https://test-provider.example/hpp"
# NESTPAY_HPP_URL_PROD="https://provider.example/hpp"
# NESTPAY_OK_URL="https://narodnanosnja.rs/api/payments/nestpay/callback/success"
# NESTPAY_FAIL_URL="https://narodnanosnja.rs/api/payments/nestpay/callback/fail"
# NESTPAY_LANG="sr"
# NESTPAY_CURRENCY="941"
# NESTPAY_TRANTYPE="Auth"
# NESTPAY_INSTALLMENT=""
